{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dashboard:prod"
      ],
      "port": 3000
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "--port",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "dashboard-attach",
      "url": "http://localhost:3000"
    },
    {
      "name": "dashboard-external",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PELICAN_RUNNER=external",
        "pnpm",
        "dev",
        "--port",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "dashboard-readonly",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PELICAN_READONLY=1",
        "pnpm",
        "dev",
        "--port",
        "3004"
      ],
      "port": 3004
    }
  ]
}
